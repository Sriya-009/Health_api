PORT=5000
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_PATH=server/data/monitoring.sqlite
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
API_REQUEST_TIMEOUT_MS=8000

# Use EMAIL_PROVIDER=console while developing, or EMAIL_PROVIDER=resend for real email.
EMAIL_PROVIDER=console
EMAIL_FROM=api-monitor@example.com

# Required when EMAIL_PROVIDER=resend. Never expose this in frontend/Vite variables.
RESEND_API_KEY=

# Legacy alert-server sender/recipient settings. Monitor alerts always use the monitor owner's email.
ALERT_TO_EMAIL=your-email@example.com
ALERT_FROM_EMAIL=alerts@example.com

# Optional SMTP provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# For SMTP, set EMAIL_PROVIDER=smtp and use an app password or provider token.
